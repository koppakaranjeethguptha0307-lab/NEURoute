# NEURoute Production Environment Configuration Template
# Copy this file to .env on your deployment host / environment settings.
# NEVER commit passwords, database URLs, or private keys to source control.

# Database Configuration (PostgreSQL + PostGIS Required)
DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/neuroute

# Server Environment & Port Binding
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET=generate-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Domains (Comma-separated or wildcard)
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# Operational Modes
MOCK_DATA_MODE=false

# External Provider Configurations
ROUTING_PROVIDER=osrm
ROUTING_PROVIDER_URL=https://router.project-osrm.org
ROUTING_PROVIDER_API_KEY=

WEATHER_PROVIDER=openmeteo
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1
WEATHER_PROVIDER_API_KEY=
