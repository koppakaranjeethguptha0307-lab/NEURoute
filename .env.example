# NEURoute Environment Variables Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit real passwords, API keys, or secrets to version control.

# Database Configuration (PostgreSQL + PostGIS Production / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.voijokyshvcekkddjbzt.supabase.co:5432/postgres

# SQLite Demo Mode (Uncomment to force local SQLite zero-config mode)
# DATABASE_URL=sqlite:///./neuroute.db

# Application & Auth Settings
ENVIRONMENT=development
JWT_SECRET=your-secure-jwt-secret-key-here
MOCK_DATA_MODE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
